# Recognized by Netlify and Cloudflare Pages (and adaptable to nginx/Apache/other
# static hosts — see docs/SECURITY.md). This is the real, server-enforced CSP;
# the <meta> tag in index.html is a same-policy fallback for hosts that ignore
# this file, but a meta tag alone can't enforce frame-ancestors (browsers ignore
# it there) and only takes effect after the HTML starts parsing. Keep both in
# sync by hand — there's no build step to generate one from the other.
# script-src's blob:/wasm-unsafe-eval tokens exist only for app.html's AI
# assistant (js/ai.js + js/ai-worker.js) — see the longer comment beside
# app.html's own <meta> CSP tag and docs/ARCHITECTURE.md "On-device AI
# assistant" for why each was needed. Applied sitewide since this file has
# one policy for everything, but they're inert on every page that isn't
# app.html. static.cloudflareinsights.com is allowed because the zone has
# Cloudflare Web Analytics' automatic beacon injection enabled -- Cloudflare
# injects that script into every HTML response at the edge, so it has to be
# allowed sitewide too, not opted into per page.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval' https://static.cloudflareinsights.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; connect-src *;
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Versioned static assets (cache-busted via ?v= query strings — see
# CLAUDE.md's cache-busting discipline) are safe to cache aggressively:
# a content change always ships under a new ?v= URL, so the browser cache
# never serves stale bytes under the old URL.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable
